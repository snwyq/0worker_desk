# 0Worker (0号员工) - 环境变量配置模板
# 使用说明：
# 1. 复制此文件并重命名为 .env
# 2. 填入您的私有 API 密钥
# 3. 重新启动应用程序

# --- AI 创作引擎配置 ---
# 通义千问 (DashScope) API Key: https://dashscope.console.aliyun.com/
DASH_SCOPE_API_KEY=your_dashscope_key_here

# Gemini (通过 APIYi 代理) API Key: https://apiyi.com/
API_YI_KEY=your_apiyi_key_here

# --- 浏览器自动化配置 ---
# AdsPower Local API Key: 进入 AdsPower 客户端 -> 设置 -> API 设置
ADSPOWER_API_KEY=your_adspower_key_here

# --- 系统高级配置 (可选) ---
# 本地 HTTP API 运行端口 (默认: 5183)
# PORT=5183
